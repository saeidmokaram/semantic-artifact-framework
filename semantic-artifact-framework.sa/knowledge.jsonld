    {
      "@id": "concept:knowledge-outcome",
      "@type": "Concept",
      "label": "Knowledge outcome",
      "statement": "The governed, evolving and scope-bounded total record generated through a work activity. It may include raw data and source material, experimental setup, parameters, tool or machine output, code, observations, relationships, discussions, trials, errors, factual assertions, interpretations, conclusions, decisions, provenance, history, and explicit gaps. Items may range from minimally interpreted evidence to mature judgement; inclusion does not itself warrant truth, completeness, agreement, or intellectual ownership. The representation is independent of whether people, agentic systems, or combinations performed the activity and independent of any one deliverable format.",
      "status": "working-thesis",
      "review_status": "author-reviewed",
      "origin": "human",
      "evidence_level": "direct-source",
      "audiences": [
        "audience:all",
