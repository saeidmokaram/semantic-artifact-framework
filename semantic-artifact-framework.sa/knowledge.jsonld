    {
      "@id": "concept:cross-artifact-semantic-reference",
      "@type": "Concept",
      "label": "Cross-artifact semantic reference",
      "statement": "An explicit semantic relation from an object in one identified artifact to an object in another identified artifact. It preserves the source and target artifact identities, target release when fixed, object identities, asserted relation, resolution behaviour, provenance, status and any material mapping decision rather than treating loading as inheritance or silently copying meaning.",
      "status": "working-thesis",
      "review_status": "author-reviewed",
