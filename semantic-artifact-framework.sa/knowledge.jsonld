      "@id": "concept:federated-semantic-collaboration",
      "@type": "Concept",
      "label": "Federated semantic collaboration",
      "statement": "A collaboration model in which independently governed semantic artifacts are queried and aligned for a shared task while preserving each artifact's identity, provenance, authority, permissions, version, terminology, disagreements, and declared gaps. Every represented cross-artifact mapping, transformation, conflict decision, and joint derivation remains an identified and inspectable semantic record rather than an opaque merge.",
      "status": "working-thesis",
      "review_status": "author-reviewed",
      "origin": "human",
      "evidence_level": "direct-source",
      "audiences": [
