      "version": 1
    },
    {
      "@id": "claim:exact-expression-preservation",
      "@type": "Claim",
      "label": "Exact expression should be preserved when form is part of meaning",
      "statement": "Structured representation can reduce ambiguity for facts and relationships, but natural-language wording and other expressive form may itself be essential evidence. In stories, dialogue, testimony, journals, music, art, demonstrations, and experience records, meaning may depend on exact words, voice, tone, timing, rhythm, gesture, visual composition, ambiguity, or idiomatic expression. The semantic artifact should therefore be able to preserve the original expression alongside structured descriptions and interpretations.",
      "status": "working-thesis",
      "review_status": "author-reviewed",
      "origin": "human",
      "evidence_level": "direct-source",
      "audiences": [
        "audience:all",
