        "domain_expansions": {
          "science": {
            "handover": "Transfer hypotheses, protocols, failed runs, analyses, evidence, and unresolved questions to a new laboratory or research agent.",
            "views": [
              "paper",
              "methods section",
              "replication guide",
              "evidence explorer",
              "review response"
            ]
          },
          "healthcare": {
            "handover": "Transfer guideline evidence, applicability, contraindications, dates, and governance to another clinical information system without transferring clinical authority.",
            "views": [
              "clinician summary",
              "patient explanation",
              "evidence trace",
              "safety audit"
            ]
          },
          "law_and_government": {
            "handover": "Transfer authoritative text, amendment history, policy rationale, dissent, jurisdiction, and effective dates to legal or public-service agents.",
            "views": [
              "lawyer analysis",
              "citizen summary",
              "legislative timeline",
              "consultation explorer",
              "compliance view"
            ]
          },
          "education": {
            "handover": "Transfer concepts, prerequisites, misconceptions, evidence, and assessments between teaching systems or learner agents.",
            "views": [
              "curriculum",
              "adaptive lesson",
              "revision guide",
              "teacher dashboard",
              "accessible explanation"
            ]
          },
          "journalism": {
            "handover": "Transfer evidence, corroboration, contradictions, editorial decisions, corrections, and protection rules between investigative teams and agents.",
            "views": [
              "public story",
              "source map",
              "fact-check view",
              "correction history"
            ]
          },
          "manufacturing_and_built_environment": {
            "handover": "Transfer requirements, design rationale, configuration, test or commissioning evidence, failures, maintenance, and physical-state qualifications across lifecycle teams.",
            "views": [
              "operator guide",
              "maintenance brief",
              "audit trail",
              "digital thread",
              "safety case"
            ]
          },
          "cultural_heritage_and_art": {
            "handover": "Transfer assets, provenance, conservation or performance requirements, creator statements, interactions, and plural interpretations to curators, conservators, or re-performance systems.",
            "views": [
              "exhibition",
              "catalogue",
              "re-performance guide",
              "provenance explorer",
              "visitor interpretation"
            ]
          },
          "storytelling_and_games": {
            "handover": "Transfer world rules, canon, character knowledge, branches, assets, design rationale, versions, and spoiler policy to writers, designers, and player-facing agents.",
            "views": [
              "story experience",
              "writer bible",
              "continuity checker",
              "recap",
              "character perspective",
              "version-aware guide"
            ]
          },
          "organisations_and_product_design": {
            "handover": "Transfer decisions, evidence, alternatives, research, prototypes, objections, implementation, and outcomes to new teams or agents.",
            "views": [
              "onboarding guide",
              "decision history",
              "product brief",
              "executive summary",
              "research explorer"
            ]
          },
          "finance": {
            "handover": "Transfer dated evidence, assumptions, models, scenarios, objections, approvals, controls, and later outcomes with current-condition warnings.",
            "views": [
              "committee brief",
              "assumption audit",
              "scenario comparison",
              "historical rationale"
            ]
          },
          "environment_and_emergency_response": {
            "handover": "Transfer observations, uncertainty, temporal validity, models, interventions, authority, decisions, resources, and outcomes across teams or shifts.",
            "views": [
              "shift brief",
              "technical assessment",
              "community view",
              "regulatory report",
              "after-action analysis"
            ]
          },
          "personal_knowledge": {
