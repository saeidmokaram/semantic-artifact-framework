    {
      "@id": "source:author-clarification-representation-neutral-multimodal",
      "@type": "Source",
      "label": "Author clarification: representation neutrality and multimodal preservation",
      "statement": "Saeid Mokaram clarified that the approach must not be bound to embeddings, natural language, one schema, or any rapidly changing technology. It must allow structured semantics, exact human expression, and linked or retained audio, video, images, sketches, music, sensor records, and future modalities. Extracted transcripts, embeddings, annotations, and other current interpretations may aid use but need not exhaust the meaning of the original material. Each application decides which modalities to capture under its own needs and constraints.",
      "status": "authoritative-source",
      "review_status": "author-reviewed",
      "origin": "human",
      "evidence_level": "direct-source",
      "audiences": [
