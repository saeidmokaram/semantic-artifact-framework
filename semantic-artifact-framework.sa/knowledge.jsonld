    {
      "@id": "decision:tools-as-methods-not-intellectual-owners",
      "@type": "Decision",
      "label": "Record tools as methods rather than automatic intellectual owners",
      "statement": "For this work's attribution model, instruments, computers, experimental machines, software tools, and agentic systems used to execute experiments, process information, or generate higher-level computations are recorded in method and provenance. Their operation alone does not make them credited intellectual contributors or owners; human or organisational contribution, legal ownership, authority, and responsibility remain separate governance determinations.",
      "status": "accepted",
      "review_status": "author-reviewed",
      "origin": "human",
