    {
      "@id": "claim:deterministic-operations-complement-agentic-reasoning",
      "@type": "Claim",
      "label": "Deterministic semantic operations should complement agentic reasoning",
      "statement": "Semantic-artifact toolkits can implement repeatable operations such as structural validation, reference resolution, dependency traversal, closure materialisation, integrity checks and comparison. Agents and people may invoke these operations, reducing unnecessary model dependence and making routine processing more reproducible, while semantic interpretation, mapping proposals and governance decisions remain explicitly distinguished.",
