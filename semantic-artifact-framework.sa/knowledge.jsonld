    {
      "@id": "concept:valid-projection",
      "@type": "Concept",
      "label": "Valid projection",
      "statement": "A projection is valid only relative to a declared task, purpose, audience, context, time, authority, semantic snapshot and validation profile. It must identify its source artifact and material object dependencies; follow a recorded recipe or transformation process; preserve the meaning, epistemic status, qualifications, disagreement, attribution and citation scope material to its declared purpose; avoid unsupported additions unless they are explicitly labelled as external material or a new derivation; make material selection, compression and omission non-misleading within its scope; satisfy applicable format, policy, access and disclosure constraints; and remain an identifiable historical output. Validity does not require verbatim reproduction or inclusion of everything, and it does not prove that the canonical knowledge is true or complete. Historical projection validity is distinct from current applicability: a once-valid projection can become stale when its dependencies change. Executable or consequential derivatives additionally require task- and domain-specific operational testing, safety review and accountable approval.",
      "status": "proposed",
      "review_status": "needs-author-review",
      "origin": "system-proposal",
      "evidence_level": "logical-analysis",
      "audiences": [
        "audience:all",
        "audience:reader-agent",
        "audience:standards-author",
        "audience:auditor",
        "audience:researcher"
      ],
