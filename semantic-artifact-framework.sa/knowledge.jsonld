    {
      "@id": "decision:semantic-linking-over-object-inheritance",
      "@type": "Decision",
      "label": "Prefer explicit semantic linking over generic object-oriented inheritance",
      "statement": "Proposed terminology and behaviour: treat reuse across artifacts as explicit cross-artifact semantic reference, optional mapping and dependency traversal rather than generic object-oriented inheritance. A relation may deliberately state extension or specialisation, and a profile may adopt OWL imports, but loading one artifact must not implicitly inherit all meaning, authority, policy, permissions or history from another.",
      "status": "proposed",
      "review_status": "needs-author-review",
      "origin": "system-proposal",
      "evidence_level": "logical-analysis",
