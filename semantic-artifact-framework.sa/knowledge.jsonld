    {
      "@id": "concept:semantic-capture-fidelity",
      "@type": "Concept",
      "label": "Semantic capture fidelity",
      "statement": "The degree to which a semantic artifact faithfully represents the available source record across a traceable chain: source data and observations; factual or asserted items; relationships among those items; interpretations, conclusions, ideas, or other derivatives; and the derivation relationships connecting higher-level knowledge to its inputs. Fidelity includes preserving qualification, provenance, epistemic status, disagreement, temporal state, and explicit absence rather than merely storing plausible statements.",
      "status": "working-thesis",
      "review_status": "author-reviewed",
      "origin": "human",
      "evidence_level": "direct-source",
      "audiences": [
        "audience:all",
