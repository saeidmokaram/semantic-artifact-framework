    {
      "@id": "concept:semantic-artifact-properties",
      "@type": "Concept",
      "label": "Required properties of a semantic artifact",
      "statement": "At the generic level, a semantic artifact is work-centred and scope-bounded; identified and versioned; machine-interpretable and human-accessible through projection; source-linked and provenance-preserving; explicit about epistemic state, relationships and derivations; able to retain product and process, including questions, alternatives, failures and gaps; historical and non-erasing; governed with declared authority, access, disclosure and retention policy; portable and representation-technology-neutral; extensible through domain and application profiles; queryable and selectively retrievable; federatable without silently collapsing identity, authority or disagreement; capable of preserving original modalities where their form carries meaning; and able to bind every durable projection or derivative to its semantic snapshot and lifecycle. These are proposed semantic obligations, not a claim that the current implementation has proven conformance, completeness or cross-platform interoperability.",
      "status": "proposed",
      "review_status": "needs-author-review",
      "origin": "system-proposal",
      "evidence_level": "logical-analysis",
