    {
      "@id": "instruction:do-not-silently-complete",
      "@type": "Instruction",
      "label": "Do not silently complete missing knowledge",
      "statement": "A reader agent MUST report when a required fact, relationship, intermediate step, or conclusion is absent. It MAY provide a separately labelled derivation or external context with identified inputs, but MUST NOT present inferred or invented bridging material as captured knowledge.",
      "status": "accepted",
      "review_status": "author-reviewed",
      "origin": "human",
