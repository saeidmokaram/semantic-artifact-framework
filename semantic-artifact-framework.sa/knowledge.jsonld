        "domain:publishing",
        "domain:software",
        "domain:healthcare"
      ],
      "relations": [],
      "provenance": [],
      "tags": [
        "author-clarification",
        "output-lifecycle",
        "snapshot",
        "currentness",
        "impact-analysis",
        "feedback"
      ],
      "version": 1
    },
    {
      "@id": "concept:traceable-output-lifecycle",
      "@type": "Concept",
      "label": "Traceable output lifecycle",
      "statement": "The governed lifecycle of a projection or derivative from generation through use, historical preservation, currentness checking, update or regeneration, validation, approval, and possible feedback into the knowledge source. The output remains an identifiable snapshot of what was generated for a task, purpose, audience, time, and authority from specified semantic objects, versions, policies, external inputs, and a generation process. Later source changes can be compared against those dependencies without rewriting the historical output.",
      "status": "working-thesis",
      "review_status": "author-reviewed",
      "origin": "human",
      "evidence_level": "direct-source",
      "audiences": [
        "audience:all",
        "audience:reader-agent",
