    {
      "@id": "concept:knowledge-gap-clarification-loop",
      "@type": "Concept",
      "label": "Knowledge-gap clarification loop",
      "statement": "When a query cannot be answered from authorised represented knowledge, the system records or exposes a precise gap instead of inventing an answer. Under the artifact's governance and access rules, the gap can be routed to an appropriate contributor, team or accountable authority; their response is incorporated through an attributed contribution and review event. A permitted automated process may instead propose a traceable derivation or external addition, but it remains labelled and governed rather than silently becoming source knowledge. The loop turns failed retrieval into a visible request for knowledge improvement.",
      "status": "working-thesis",
      "review_status": "author-reviewed",
      "origin": "human",
      "evidence_level": "direct-source",
      "audiences": [
