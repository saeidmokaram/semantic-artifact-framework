    {
      "@id": "claim:ai-mediated-semantic-artifacts-expand-expression-capacity",
      "@type": "Claim",
      "label": "AI-mediated semantic artifacts may expand effective human knowledge-expression capacity",
      "statement": "By helping to capture heterogeneous traces during work, extract and relate semantic items, preserve provenance and source form, maintain history, and generate task-specific explanations or derivatives, agentic systems may let a person or group externalise and share substantially more of what they know and how they reached it than unaided document-centred communication permits. This can reduce some physical, biological, attentional, and authoring bottlenecks, but it does not free thought from embodiment, copy a mind, eliminate tacit knowledge, or guarantee faithful interpretation and shared understanding.",
      "status": "working-thesis",
      "review_status": "author-reviewed",
      "origin": "human",
      "evidence_level": "direct-source",
      "audiences": [
        "audience:all",
        "audience:researcher",
        "audience:engineer",
        "audience:executive"
      ],
      "domains": [
