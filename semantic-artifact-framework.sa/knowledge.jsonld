    {
      "@id": "claim:semantic-artifacts-organise-work-and-knowledge",
      "@type": "Claim",
      "label": "Semantic artifacts can organise work and knowledge together",
      "statement": "A semantic artifact can organise ongoing work and the knowledge produced through that work in one governed, connected state. It can relate goals, requirements, sources, raw information, activities, experiments, evidence, questions, assumptions, alternatives, decisions, responsibilities, risks, gaps, outcomes and learning, then provide role-, task-, goal- and time-specific views without making each view an independent source of truth. This is a proposed cross-domain capability, not yet evidence that every activity benefits or that capture and governance costs are negligible.",
      "status": "working-thesis",
      "review_status": "author-reviewed",
      "origin": "human",
