      "@id": "decision:current-state-plus-immutable-events",
      "@type": "Decision",
      "label": "Keep canonical semantic state and append-only history as distinct coordinated roles",
      "statement": "The current Framework profile uses semantic objects as a queryable canonical semantic state and a separate append-only contribution and semantic-change history as the historical record. The current state includes every retained object's present epistemic and review status; the history records introduction, review, revision, challenge, rejection and supersession without erasing earlier events. Meaning-changing revision uses version or revision links, and a consumer may read the materialised current state without replaying all events. This role distinction is semantic; it does not require every implementation to use the current files or storage technology.",
      "status": "accepted",
      "review_status": "author-reviewed",
      "origin": "human",
      "evidence_level": "logical-analysis",
      "audiences": [
        "audience:engineer",
        "audience:auditor",
        "audience:standards-author"
      ],
      "domains": [
        "domain:cross-domain",
        "domain:publishing"
      ],
      "relations": [
        {
          "predicate": "answers",
          "target": "question:canonical-state-or-history"
