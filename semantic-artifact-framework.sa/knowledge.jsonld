    {
      "@id": "concept:epistemic-reconstruction",
      "@type": "Concept",
      "label": "Epistemic reconstruction",
      "statement": "The ability of a later person or system to traverse a work's preserved source records, data, observations, relations, attempts, failures, decisions, and attributed interpretations so it can reconstruct and interrogate the recorded journey from a new purpose or perspective. It can approximate aspects of encountering the work as it developed, but it cannot literally reproduce subjective experience, tacit context, inaccessible material, or anything that was not captured.",
      "status": "working-thesis",
      "review_status": "author-reviewed",
      "origin": "human",
      "evidence_level": "direct-source",
      "audiences": [
        "audience:all",
        "audience:reader-agent",
        "audience:researcher",
        "audience:auditor",
        "audience:archivist"
      ],
