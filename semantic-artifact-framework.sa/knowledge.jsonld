    {
      "@id": "source:author-clarification-document-abundance-transition",
      "@type": "Source",
      "label": "Author clarification: from scarce documents through document abundance to knowledge-first collaboration",
      "statement": "Saeid Mokaram framed knowledge-first, views-second as a natural candidate evolution in humanity's knowledge media. Earlier capture depended heavily on bounded human-authored forms such as writing, documents and visual representations because production and reading demanded substantial effort. AI and agentic systems now make documents faster and cheaper to generate, increasing detail and volume while leaving human attention and digestion as bottlenecks. This AI-abundant document phase still inherits report, chapter, README and changelog structures designed primarily for human reading and therefore does not capture the full work journey. The proposed next step is to make governed semantic knowledge the primary machine-usable source, generate distilled or interactive human views when needed, let people interrogate it as they would question a knowledgeable collaborator, expose unanswered questions as gaps, route gaps to responsible contributors or permitted automated processes, and potentially reduce coordination layers, repetitive meetings, handover loss and manual agent priming.",
      "status": "authoritative-source",
      "review_status": "author-reviewed",
      "origin": "human",
      "evidence_level": "direct-source",
      "audiences": [
        "audience:all"
      ],
      "domains": [
        "domain:cross-domain",
        "domain:organisational-memory",
        "domain:software",
        "domain:publishing"
      ],
      "relations": [],
      "provenance": [],
      "tags": [
        "author-clarification",
        "knowledge-medium-evolution",
        "document-abundance",
        "attention-bottleneck",
        "interactive-dialogue",
        "gap-escalation",
        "flatter-collaboration"
      ],
      "version": 1
    },
    {
      "@id": "concept:three-stage-knowledge-medium-transition",
      "@type": "Concept",
      "label": "Three-stage knowledge-medium transition",
      "statement": "The work proposes a three-stage transition model. In a document-scarce stage, the effort of authoring and consuming records favours strong selection and compression into bounded representations. In an AI-abundant document stage, machine assistance lowers production cost and increases volume and richness, but human attention, discovery and digestion remain scarce while inherited human-readable templates still select and omit much of the work journey. In a knowledge-first stage, governed semantic knowledge becomes the primary reusable and machine-usable source, while stable, distilled, interactive or task-specific views are produced when needed. The stages can coexist and the model is a prospective interpretation, not a deterministic law of history or a claim that earlier media were exclusively linear or semantically empty.",
      "status": "working-thesis",
      "review_status": "author-reviewed",
      "origin": "human",
      "evidence_level": "direct-source",
      "audiences": [
        "audience:all",
        "audience:researcher",
        "audience:executive",
        "audience:standards-author"
      ],
      "domains": [
        "domain:cross-domain",
        "domain:publishing",
        "domain:organisational-memory",
        "domain:cultural-heritage"
      ],
      "relations": [
        {
          "predicate": "dependsOn",
          "target": "claim:documentation-abundance"
        },
        {
          "predicate": "dependsOn",
          "target": "argument:attention-bottleneck"
        },
        {
          "predicate": "dependsOn",
          "target": "claim:ai-expands-practical-capture-frontier"
        },
        {
          "predicate": "supports",
          "target": "claim:semantic-artifact-as-new-knowledge-medium"
        },
