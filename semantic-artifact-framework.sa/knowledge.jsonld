          "target": "claim:outputs-as-projections-and-derivatives"
        },
        {
          "predicate": "requires",
          "target": "claim:non-erasing-semantic-history"
        },
        {
          "predicate": "requires",
          "target": "concept:provenance"
        },
        {
          "predicate": "mitigates",
          "target": "risk:stale-output-use"
        }
      ],
      "provenance": [
        {
          "source": "source:author-clarification-traceable-output-lifecycle",
          "locator": {
            "section": "compare a generated view or derivative with later knowledge"
          },
          "basis": "direct"
        }
      ],
      "tags": [
