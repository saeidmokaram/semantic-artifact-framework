    {
      "@id": "source:author-clarification-configurable-governance",
      "@type": "Source",
      "label": "Author clarification: governance authority is declared and configurable",
      "statement": "Saeid Mokaram clarified that the founding author or releasing authority may define the artifact's contribution and acceptance rules at the beginning and make them clearly available to users. A work may allow openly attributed additions while preserving immutable history, or restrict canonical changes to the author or a controlled repository. No single governance model is selected for all works; different models should be explored through practical use by different people and in different scenarios.",
      "status": "authoritative-source",
