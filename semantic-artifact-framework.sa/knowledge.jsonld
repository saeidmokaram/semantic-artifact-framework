    {
      "@id": "concept:declared-governance-profile",
      "@type": "Concept",
      "label": "Declared governance profile",
      "statement": "A machine-readable and human-visible policy attached to a semantic artifact that identifies its founding or releasing authority; contribution channels; write permissions; semantic roles; who may propose, review, accept, reject, challenge, correct, supersede, retract, release, or amend policy; how disputes, succession, forks, and revocation work; and which technical controls enforce those rules. The profile governs canonical status without erasing the provenance of proposals or earlier policy states.",
      "status": "working-thesis",
      "review_status": "author-reviewed",
      "origin": "human",
      "evidence_level": "direct-source",
