    {
      "@id": "decision:standards-aligned-exchange-profile",
      "@type": "Decision",
      "label": "Use a standards-aligned exchange profile without fixing one internal technology",
      "statement": "Proposed architecture: retain the framework's technology-neutral abstract obligations; align artifact and release boundaries with RDF datasets and named graphs; use JSON-LD 1.1 for graph exchange, PROV-O for provenance, SHACL for validation, SKOS where concept mappings fit, the Profiles Vocabulary for profile declarations, RO-Crate for portable packaging, SPARQL as an optional query interface and RDF Dataset Canonicalization for optional hashing. Keep OWL imports optional for profiles that intentionally adopt ontology entailment rather than treating them as the general inheritance model.",
      "status": "proposed",
      "review_status": "needs-author-review",
      "origin": "system-proposal",
      "evidence_level": "authoritative-standard",
      "audiences": [
        "audience:engineer",
