    {
      "@id": "decision:minimal-public-semantic-artifact-package",
      "@type": "Decision",
      "label": "Keep the public Semantic Artifact package minimal and self-describing",
      "statement": "The current attached exchange profile places the manifest, canonical semantic state and append-only semantic history under one visible, work-named directory ending in .sa. The three role files use the exact names semantic-artifact.jsonld, knowledge.jsonld and history.jsonld so tools can discover them deterministically; content validation must also confirm that each file satisfies its named role. Short human and agent access adapters may remain at a host repository boundary where existing platforms need them, but they are not additional canonical knowledge stores. A licence and machine-validation resources are supporting infrastructure. Research working records, release instructions, generated projections, evaluation outputs and implementation tools are not duplicated in the package; when retained, they are separate linked artifacts, releases or repositories with their own identity and lifecycle. Loose renamed files may be imported by content and normalised, while strict .sa packages require the fixed internal names. For transport without Git, a host may reproducibly serialize the complete directory as <work-name>.sa.zip and publish a machine-readable descriptor containing identity, snapshot, download URL, media type, size, member list and SHA-256 hash. Extraction must restore the unchanged .sa root and required entries; the archive and descriptor remain transport resources rather than independent canonical stores. This is a proposed distribution profile and current repository convention, not a universal definition of Semantic Artifact meaning or a requirement to use JSON-LD, directories, ZIP or Git in every implementation.",
      "status": "accepted",
      "review_status": "author-reviewed",
      "origin": "human",
      "evidence_level": "direct-source",
      "audiences": [
        "audience:all",
        "audience:reader-agent",
        "audience:engineer",
        "audience:standards-author"
      ],
      "domains": [
        "domain:cross-domain"
      ],
      "relations": [
        {
          "predicate": "derivedFrom",
          "target": "source:author-clarification-minimal-public-semantic-package"
        },
        {
          "predicate": "derivedFrom",
          "target": "source:author-proposal-sa-directory-package"
        },
        {
          "predicate": "supersedes",
          "target": "decision:portable-five-file-bootstrap-package"
        },
        {
          "predicate": "supports",
          "target": "claim:artifact-as-starter-standard"
        },
        {
          "predicate": "supports",
          "target": "claim:document-as-projection"
        },
        {
          "predicate": "qualifies",
          "target": "decision:jsonl-jsonld"
        }
      ],
