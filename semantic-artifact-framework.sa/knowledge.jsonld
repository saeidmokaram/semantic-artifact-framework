    {
      "@id": "decision:jsonl-jsonld",
      "@type": "Decision",
      "label": "JSON-LD graph exchange is the current repository implementation",
      "statement": "The repository stores canonical semantic state and append-only contribution history as JSON-LD 1.1 graph documents using stable @id, @type and @graph constructs. In the current attached directory profile, these documents and their manifest use exact role-specific filenames within a visible .sa package. This aligns the inspectable repository representation with the RDF data model and proposed SHACL constraints; the former JSON Lines canonical stores have been removed from the active repository. JSON-LD and the directory layout remain implementation and exchange choices rather than the identity of a Semantic Artifact: another implementation may use a different present or future technology if it preserves the required meaning, identity, provenance, relationships, history, policies, source-derivative distinctions, disclosure and exchange behaviour.",
      "status": "accepted",
      "review_status": "author-reviewed",
      "origin": "human",
      "evidence_level": "direct-source",
      "audiences": [
        "audience:engineer",
        "audience:standards-author"
      ],
      "domains": [
        "domain:publishing",
        "domain:cross-domain"
      ],
      "relations": [
        {
          "predicate": "derivedFrom",
          "target": "source:w3c-jsonld"
        },
        {
          "predicate": "mitigates",
          "target": "risk:semantic-lock-in"
        },
        {
          "predicate": "qualifies",
          "target": "claim:representation-technology-neutral"
        },
        {
          "predicate": "supports",
          "target": "decision:standards-aligned-exchange-profile"
        }
      ],
      "provenance": [
        {
          "source": "source:w3c-jsonld",
          "locator": {
            "sections": [
              "Abstract",
              "1.5"
            ]
          },
          "basis": "inference"
        },
        {
          "source": "source:author-clarification-representation-neutral-multimodal",
          "locator": {
            "section": "no fixed storage or representation technology"
          },
          "basis": "direct"
        },
        {
          "source": "source:author-clarification-cross-artifact-linking-and-toolkit",
          "locator": {
            "section": "adopt established knowledge-graph and semantic-graph methods where appropriate"
