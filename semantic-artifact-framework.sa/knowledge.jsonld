    {
      "@id": "question:effective-expression-capacity-evaluation",
      "@type": "Question",
      "label": "How should effective knowledge-expression capacity be evaluated?",
      "statement": "Compared with a conventional document-centred or unaided workflow, does an AI-mediated semantic artifact increase the amount and diversity of relevant knowledge that becomes durably accessible without reducing semantic fidelity? Candidate measures include source and relationship recall, provenance accuracy, retained qualifications and disagreement, recipient comprehension, successful task completion, accessibility across communication abilities, author and reviewer effort, context cost, latency, error rate, overload, and the ability to identify what remains tacit, missing, or uncertain.",
      "status": "open",
      "review_status": "author-reviewed",
      "origin": "human",
      "evidence_level": "none",
      "audiences": [
