    {
      "@id": "concept:semantic-dependency-closure",
      "@type": "Concept",
      "label": "Semantic dependency closure",
      "statement": "The deterministic set obtained by starting from declared seed objects and repeatedly following only the relation and provenance directions allowed by a recorded traversal policy across the supplied artifact releases. The closure is reproducible for the same immutable inputs and policy, but is complete only relative to those inputs and rules.",
      "status": "proposed",
      "review_status": "needs-author-review",
      "origin": "system-proposal",
      "evidence_level": "logical-analysis",
      "audiences": [
        "audience:reader-agent",
        "audience:engineer",
        "audience:auditor",
        "audience:standards-author"
