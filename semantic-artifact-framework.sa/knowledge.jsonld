        "projection",
        "derivative",
        "snapshot",
        "currentness",
        "maintenance"
      ],
      "version": 1
    },
    {
      "@id": "claim:output-binds-to-semantic-snapshot",
      "@type": "Claim",
      "label": "Every durable output should identify the knowledge snapshot and dependencies used",
      "statement": "A retained paper, report, recommendation, interface, code artifact, configuration, plan, or other generated output should record its identity, generation time, task, purpose, audience, authority, recipe or process, semantic release or snapshot, specific input object identifiers and versions, applicable policies, and material external inputs. Citations may present this lineage in ordinary human form, while a machine-readable manifest supports precise comparison and regeneration.",
