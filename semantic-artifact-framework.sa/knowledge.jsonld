    {
      "@id": "concept:canonical-semantic-state",
      "@type": "Concept",
      "label": "Canonical semantic state",
      "statement": "The governance-designated current representation of what a named Semantic Artifact records for a declared scope, authority, release and snapshot. It includes accepted, proposed, contested, rejected, superseded and open objects with their status, identity, provenance and relationships; canonical means the authoritative represented state, not that every assertion is true, complete, immutable or universally accepted. It is distinct from, and interpreted together with, the append-only contribution and semantic-change history that explains how the state arose.",
      "status": "accepted",
      "review_status": "author-reviewed",
      "origin": "human",
      "evidence_level": "direct-source",
      "audiences": [
        "audience:all",
        "audience:reader-agent",
        "audience:engineer",
        "audience:auditor",
        "audience:standards-author"
      ],
      "domains": [
