    {
      "@id": "concept:fidelity-constrained-document-equivalent",
      "@type": "Concept",
      "label": "Fidelity-constrained document equivalent",
      "statement": "A fidelity-constrained document equivalent is a declared conventional document or document corpus that is tested against a specified Semantic Artifact snapshot, semantic-unit inventory, purpose and fidelity threshold. Its footprint is the smallest result observed under a disclosed generation and validation protocol that preserves the required objects, relationships, provenance, epistemic status, qualifications, disagreements, history and explicit gaps. It is an empirical benchmark rather than a unique theoretical minimum: size depends on language, format, audience, authoring style, tokenizer and validation threshold. When an original modality or exact expression carries material meaning that prose cannot preserve, the benchmark must include that source or report the affected semantic units as non-representable; it must not call a lossy text substitute equivalent.",
      "status": "proposed",
      "review_status": "needs-author-review",
      "origin": "system-proposal",
      "evidence_level": "logical-analysis",
      "audiences": [
        "audience:researcher",
        "audience:engineer",
        "audience:auditor",
        "audience:standards-author"
      ],
      "domains": [
        "domain:cross-domain"
      ],
      "relations": [
        {
          "predicate": "answers",
          "target": "question:semantic-artifact-document-equivalent-and-token-efficiency-evaluation"
        },
        {
          "predicate": "requires",
          "target": "concept:semantic-fidelity"
        },
        {
          "predicate": "comparesWith",
          "target": "concept:projection"
        },
        {
          "predicate": "qualifiedBy",
          "target": "claim:semantic-artifact-efficiency-is-quality-conditioned-and-amortized"
        }
      ],
      "provenance": [
        {
          "source": "source:author-proposal-document-equivalent-and-token-efficiency-metrics",
          "locator": {
            "section": "equivalent conventional document size"
          },
          "basis": "inference"
        }
      ],
      "tags": [
        "document-equivalent",
        "semantic-coverage",
        "fidelity-threshold",
        "benchmark",
        "multimodal-boundary"
      ],
      "version": 1
    },
    {
      "@id": "concept:semantic-artifact-efficiency-metric-suite",
      "@type": "Concept",
      "label": "Semantic Artifact efficiency metric suite",
      "statement": "A reproducible evaluation suite that measures representation footprint, task-time context, semantic result quality, repeated-use cost and update cost separately. It does not treat raw token reduction as a benefit unless the compared conditions use the same declared knowledge scope and the Semantic Artifact condition meets the required fidelity and task-quality thresholds. Token counts are tokenizer- and model-dependent and must identify the tokenizer, model-visible inputs, outputs, cache treatment, retrieved context and tool exchanges. Bytes and characters provide tokenizer-independent companion measurements. The preferred experimental comparison includes at least a conventional document condition, a full Semantic Artifact condition and a Semantic Artifact with bounded retrieval condition.",
      "status": "proposed",
      "review_status": "needs-author-review",
      "origin": "system-proposal",
      "evidence_level": "logical-analysis",
      "audiences": [
        "audience:researcher",
        "audience:engineer",
        "audience:auditor",
        "audience:standards-author"
      ],
      "domains": [
        "domain:cross-domain",
        "domain:software",
        "domain:publishing",
        "domain:organisational-memory"
      ],
      "relations": [
        {
          "predicate": "answers",
          "target": "question:semantic-artifact-document-equivalent-and-token-efficiency-evaluation"
        },
        {
          "predicate": "measures",
          "target": "benefit:context-efficiency"
        },
        {
          "predicate": "measures",
          "target": "claim:context-efficient-retrieval"
        },
        {
          "predicate": "uses",
          "target": "concept:fidelity-constrained-document-equivalent"
        },
        {
          "predicate": "qualifiedBy",
          "target": "risk:token-efficiency-metric-gaming"
        }
      ],
      "provenance": [
        {
          "source": "source:author-proposal-document-equivalent-and-token-efficiency-metrics",
          "locator": {
            "section": "similar metrics to support claimed benefits"
          },
          "basis": "synthesis"
        }
      ],
      "tags": [
        "evaluation",
        "metric-suite",
        "token-efficiency",
        "context-cost",
        "semantic-quality",
        "amortisation",
        "maintenance"
      ],
      "version": 1,
      "metadata": {
        "metrics": [
          {
            "name": "Semantic coverage score",
            "symbol": "SCS",
            "definition": "Weighted proportion of the declared semantic-unit inventory recoverable from the evaluated representation, reported separately for objects, properties, relations, provenance, status, qualifications, disagreements, history and explicit gaps."
          },
          {
            "name": "Document-equivalent footprint",
            "symbol": "DEF",
            "definition": "Minimum observed byte, character and tokenizer-token footprint among tested conventional document representations that satisfy the declared semantic-coverage and fidelity thresholds; not a claim of a global theoretical minimum."
          },
          {
            "name": "Full Semantic Artifact footprint",
            "symbol": "SAF_full",
            "definition": "Byte, character and tokenizer-token footprint of the declared in-scope serialized Semantic Artifact snapshot, reported separately for manifest, canonical knowledge, history and retained source resources."
          },
          {
            "name": "Representation footprint ratio",
            "symbol": "RFR",
            "formula": "DEF / SAF_full",
            "interpretation": "Greater than one means the tested fidelity-constrained document equivalent is larger than the full serialized Semantic Artifact under the same tokenizer and scope; it does not measure task performance."
          },
          {
            "name": "Task context cost",
            "symbol": "TCC(q)",
            "definition": "All model-visible input tokens used to complete task q, including instructions, retrieved content, repeated context and model-visible tool results; cached and uncached tokens are reported separately."
          },
          {
            "name": "Context reduction rate",
            "symbol": "CRR(q)",
            "formula": "1 - TCC_SA(q) / TCC_document(q)",
            "interpretation": "Positive values indicate fewer task-input tokens for the Semantic Artifact condition; negative values indicate more. The result is valid only beside fidelity and task-quality results."
          },
          {
            "name": "Quality-adjusted semantic context efficiency",
            "symbol": "QSCE(q)",
            "formula": "verified required semantic units correctly delivered / (TCC(q) / 1000)",
            "interpretation": "Reports useful semantic delivery per thousand model-visible input tokens while keeping error, unsupported-addition, provenance and contradiction scores visible rather than hiding them in one aggregate."
          },
          {
            "name": "Amortized net token benefit",
            "symbol": "ANTB(n)",
            "formula": "total document-condition tokens through n tasks minus total Semantic-Artifact-condition tokens through n tasks",
            "interpretation": "Both totals include initial construction or conversion, validation, indexing, retrieval, maintenance, updates, model-visible tool exchanges and task execution under declared accounting rules."
          },
          {
            "name": "Break-even task count",
            "symbol": "BET",
            "definition": "Smallest number of comparable tasks n for which ANTB(n) becomes positive while the Semantic Artifact condition satisfies the declared quality and fidelity thresholds."
          },
          {
            "name": "Update propagation cost",
            "symbol": "UPC",
            "definition": "Human effort, machine operations and tokens required to incorporate one controlled semantic change, identify affected outputs, restore consistency and validate the result; stale or missed outputs are counted as errors rather than savings."
          }
        ],
        "minimum_reporting": [
          "artifact identity, release and snapshot",
          "included files, source resources and excluded modalities",
          "semantic-unit inventory and weighting",
          "coverage, fidelity and task-quality thresholds",
          "document baseline definition and generation process",
          "model, tokenizer, prompts, retrieval method and context limits",
          "cached input, uncached input, output, reasoning and model-visible tool tokens when available",
          "construction, conversion, indexing, validation and maintenance cost",
          "task suite, repetitions, ordering and randomisation",
          "latency, errors, unsupported additions and non-representable units"
        ]
      }
    },
    {
      "@id": "claim:semantic-artifact-efficiency-is-quality-conditioned-and-amortized",
      "@type": "Claim",
      "label": "Semantic Artifact efficiency is quality-conditioned and amortized",
      "statement": "Token efficiency is not an inherent property established by using a Semantic Artifact format. A full serialized graph can contain more tokens than a concise document because explicit identity, structure, provenance and history have a representation cost. The expected advantage is testable at task time and across repeated uses: bounded retrieval may deliver the required context without repeatedly ingesting a comprehensive document, and one governed source may reduce duplicated authoring and update work across many projections. A benefit is supported only when semantic fidelity, task quality, traceability and error thresholds are met and construction, retrieval, validation, maintenance and update costs are included. The outcome may be positive, neutral or negative by artifact, task and implementation.",
      "status": "proposed",
      "review_status": "needs-author-review",
      "origin": "system-proposal",
      "evidence_level": "logical-analysis",
