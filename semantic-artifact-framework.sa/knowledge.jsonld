    {
      "@id": "claim:ai-document-abundance-is-transitional",
      "@type": "Claim",
      "label": "AI-generated document abundance is a transitional condition, not the endpoint",
      "statement": "Lowering the cost of document generation removes much of the authoring bottleneck without removing the reader's attention bottleneck or the selective structure of conventional documents. The result can be more numerous and richer documents that remain difficult to digest and still fail to preserve the full process, relationships, alternatives, failures and gaps of a work. The work treats this condition as a bridge toward knowledge-first capture rather than as the final form of AI-supported knowledge work.",
      "status": "working-thesis",
      "review_status": "author-reviewed",
      "origin": "human",
      "evidence_level": "direct-source",
