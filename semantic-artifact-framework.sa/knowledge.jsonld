    {
      "@id": "concept:semantic-artifact",
      "@type": "Concept",
      "label": "Semantic Artifact",
      "statement": "An identified, governed, versioned and provenance-preserving representation of the captured knowledge of a represented work. It contains or references a canonical semantic state, append-only contribution and semantic-change history, sources, relationships, epistemic states, policies and explicit gaps, and can support selective retrieval, federation, projections and traceable derivatives. A Semantic Artifact is independent of any one document, model, provider, repository or storage technology; the current .sa directory is an exchange profile rather than its identity.",
      "status": "working-thesis",
      "review_status": "author-reviewed",
      "origin": "human",
      "evidence_level": "logical-analysis",
      "audiences": [
        "audience:all"
      ],
      "domains": [
        "domain:cross-domain"
      ],
