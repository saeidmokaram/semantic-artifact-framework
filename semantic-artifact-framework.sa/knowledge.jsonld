    {
      "@id": "concept:effective-knowledge-expression-capacity",
      "@type": "Concept",
      "label": "Effective knowledge-expression capacity",
      "statement": "The practical capacity of a person or group to externalise what has been experienced, learned, inferred, considered, or decided in a durable form that others can inspect, trace, query, reinterpret, and reuse. It includes coverage, semantic fidelity, provenance, context, accessibility, time, effort, and retrievability; it is not identical to Shannon channel bandwidth, amount of generated text, direct transfer of mental state, or proof of mutual understanding. 'Effective knowledge-expression bandwidth' may be used as a qualified shorthand for this broader concept.",
      "status": "working-thesis",
      "review_status": "author-reviewed",
      "origin": "human",
      "evidence_level": "direct-source",
      "audiences": [
        "audience:all",
        "audience:researcher",
        "audience:engineer"
      ],
