    {
      "@id": "concept:canonicality",
      "@type": "Concept",
      "label": "Canonicality",
      "statement": "Canonicality is a declared governance and reference role, not an intrinsic property of a file format. A semantic state is canonical for a defined work, scope, authority, release and snapshot when the Semantic Artifact's governance designates it as the authoritative represented state from which projections and derivatives take their meaning, identifies the history and policies that produced it, and provides stable identities or versions to which outputs can refer. Canonical does not mean objectively true, complete, immutable, universally accepted or the only permitted copy. Competing proposals, interpretations and forks may coexist. The current Framework profile distinguishes a canonical semantic state from its append-only contribution and semantic-change history; other implementations may realise those roles differently while preserving the distinction.",
      "status": "proposed",
      "review_status": "needs-author-review",
      "origin": "system-proposal",
      "evidence_level": "logical-analysis",
      "audiences": [
        "audience:all",
