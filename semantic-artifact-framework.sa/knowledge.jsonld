    {
      "@id": "concept:explicit-federation-mapping",
      "@type": "Concept",
      "label": "Explicit federation mapping",
      "statement": "An identified semantic assertion that relates objects or concepts from two or more artifact states. It records the participating artifact and release identifiers, source and target object identifiers, mapping relation and scope, creator or tool and method, creation time, evidence or rationale, confidence and review status, applicable policy, known limitations, and later challenge, correction, or supersession. Examples include equivalent, related, narrower, broader, compatible, conflicting, transforming, and unresolved mappings.",
      "status": "working-thesis",
      "review_status": "author-reviewed",
      "origin": "human",
