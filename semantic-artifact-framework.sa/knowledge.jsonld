    {
      "@id": "source:author-clarification-traceable-output-lifecycle",
      "@type": "Source",
      "label": "Author clarification: generated outputs remain linked to evolving knowledge",
      "statement": "Saeid Mokaram clarified that papers, projections, recommendations, code, and other derivatives should retain references to the knowledge items and historical state from which they were generated. A later person or agent should be able to compare an earlier output with the latest knowledge to identify what remains valid, what changed, and what was corrected or superseded. The required update, regeneration, testing, or review depends on the task and its consequences; clinical guidance is an example where an authorised user may ask what has changed before relying on an earlier recommendation.",
      "status": "authoritative-source",
      "review_status": "author-reviewed",
      "origin": "human",
      "evidence_level": "direct-source",
      "audiences": [
        "audience:all"
      ],
      "domains": [
