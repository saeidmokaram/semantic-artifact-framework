    {
      "@id": "decision:layered-naming-architecture",
      "@type": "Decision",
      "label": "Use separate names for the work, model, specification, package, and instances",
      "statement": "Use distinct names for distinct layers: From Documents to Semantic Artifacts is the research work; Semantic Artifact (SA) is the generic governed representation and an individual instance; Semantic Artifact Framework (SAF) is the generic method and evolving proposed specification; Semantic Artifact Directory Package is the current attached exchange profile whose visible work-named directory ends in .sa; each instance also has a work-specific identity and title; Semantic Artifact Explorer (SAE) and Semantic Artifact Toolkit are optional, independently versioned tools. The Framework is not described as a formal standard unless future evidence and a legitimate standardisation process justify that status.",
      "status": "accepted",
      "review_status": "author-reviewed",
      "origin": "human",
      "evidence_level": "logical-analysis",
      "audiences": [
        "audience:all",
