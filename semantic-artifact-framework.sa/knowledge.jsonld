    {
      "@id": "risk:semantic-management-surveillance-and-metric-abuse",
      "@type": "Risk",
      "label": "Semantic management can become surveillance or metric abuse",
      "statement": "A management implementation can become an employee-surveillance system, expose sensitive personnel or communication data, confuse captured activity with contribution or value, turn generated inferences into performance judgements, grant incomplete records false authority, or optimise dashboards while weakening trust and learning. Access, purpose, consent, retention, contestability and accountable human judgement must be explicit, and individual employment or performance decisions must not be inferred solely from semantic activity records.",
      "status": "open",
      "review_status": "author-reviewed",
      "origin": "human",
      "evidence_level": "logical-analysis",
      "audiences": [
