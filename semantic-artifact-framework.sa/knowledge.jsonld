    {
      "@id": "concept:fidelity-validity-distinction",
      "@type": "Concept",
      "label": "Fidelity and validity are distinct",
      "statement": "Fidelity is a graded assessment of how well meaning and material distinctions were preserved across a transition. Validity is a governed judgement that an artifact, projection or derivative satisfies the declared requirements for a particular use. High fidelity is normally evidence for projection validity but is not sufficient: an output may faithfully represent its source and still be invalid for the current task because it is stale, outside its authorised scope, selectively incomplete for that purpose, non-compliant with policy, or lacking required domain tests and accountable approval. Conversely, a validity claim must state its scope and criteria rather than implying universal correctness.",
      "status": "proposed",
      "review_status": "needs-author-review",
      "origin": "system-proposal",
      "evidence_level": "logical-analysis",
      "audiences": [
        "audience:all",
