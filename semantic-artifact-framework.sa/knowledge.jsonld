    {
      "@id": "source:author-clarification-federation-transparency",
      "@type": "Source",
      "label": "Author clarification: federation mappings are transparent and probeable",
      "statement": "Saeid Mokaram clarified that every represented mapping across semantic artifacts—whether created by a person, agentic system, or other tool—should exist explicitly with enough provenance to inspect it. Missing information and conflicts should be identifiable and open to examination by people or tools. Federated results can still be incomplete, erroneous, or problematic; the proposed advantage over conventional methods is richer capture and the ability to probe the result more accurately, automatically, and interactively.",
      "status": "authoritative-source",
      "review_status": "author-reviewed",
