      "@id": "decision:framework-release-as-reference-artifact",
      "@type": "Decision",
      "label": "Future artifacts may reference a stable framework artifact release",
      "statement": "The Semantic Artifact Framework should be publishable as an identified, versioned reference artifact that future task-specific semantic artifacts can cite when declaring which general concepts, obligations, profile or exchange behaviour they follow. A task artifact refers only to the framework material it needs and retains its own identity, knowledge, contributors and governance; the framework is not silently copied into, made authoritative over, or counted as part of every task artifact.",
      "status": "accepted",
      "review_status": "author-reviewed",
