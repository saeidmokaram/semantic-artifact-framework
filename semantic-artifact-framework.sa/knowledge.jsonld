    {
      "@id": "instruction:multi-artifact-workspace-preserves-source-boundaries",
      "@type": "Instruction",
      "label": "Preserve source boundaries in multi-artifact work",
      "statement": "A multi-artifact user or agent MUST identify every participating artifact and release, namespace or otherwise disambiguate object identities, respect each source's access and usage policy, label automated mappings and conflict detections as proposals, and trace joint results to source objects and mapping decisions. It MUST NOT treat loading as permission to merge, turn a federation view into canonical knowledge, or resolve disagreement without the declared authorities and contribution events required by the affected artifacts and any new derived artifact.",
      "status": "accepted",
      "review_status": "author-reviewed",
      "origin": "human",
      "evidence_level": "logical-analysis",
      "audiences": [
