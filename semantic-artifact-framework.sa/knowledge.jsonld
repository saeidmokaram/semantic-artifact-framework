    {
      "@id": "concept:semantic-fidelity",
      "@type": "Concept",
      "label": "Semantic fidelity",
      "statement": "Semantic fidelity is the degree to which meaning and material distinctions survive a represented transition relative to a declared scope and purpose. It is not textual similarity, verbosity, identical structure or a claim of complete capture. Capture fidelity concerns movement from available sources and activity into semantic representation; relationship and derivation fidelity concerns whether links and higher-level conclusions accurately reflect their inputs; projection fidelity concerns movement from a specified canonical snapshot into a selected human or machine output; exchange fidelity concerns preservation across formats, platforms and implementations; and temporal fidelity concerns whether an output accurately represents the knowledge state at its stated time. Across these dimensions, fidelity includes identity, provenance, epistemic status, qualification, disagreement, uncertainty, temporal state, authority, source-versus-interpretation boundaries and explicit gaps. A faithful historical output may nevertheless be stale, inapplicable or unsafe now. Measurement thresholds and combinations of automated checks, source comparison, human review and domain validation remain open research questions.",
      "status": "proposed",
      "review_status": "needs-author-review",
      "origin": "system-proposal",
      "evidence_level": "logical-analysis",
      "audiences": [
        "audience:all",
        "audience:reader-agent",
        "audience:standards-author",
        "audience:auditor",
        "audience:researcher"
      ],
      "domains": [
