    {
      "@id": "concept:selective-self-contained-semantic-extraction",
      "@type": "Concept",
      "label": "Selective self-contained extraction of linked semantics",
      "statement": "From declared starting objects, a user or agent may select the relevant linked semantic material across one or more artifacts and produce a smaller self-contained result while retaining the exact sources, releases, relations, provenance, history, rights, conflicts, unresolved references and extraction policy. Material outside the selection is omitted from the result, not deleted or rejected in its source artifact.",
      "status": "working-thesis",
      "review_status": "author-reviewed",
      "origin": "human",
      "evidence_level": "direct-source",
      "audiences": [
