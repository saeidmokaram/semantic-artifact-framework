    {
      "@id": "concept:knowledge-representation",
      "@type": "Concept",
      "label": "Knowledge representation in a semantic artifact",
      "statement": "A knowledge representation is the identified, scope-bounded and governed system of records through which the available captured knowledge of a work is made interpretable and queryable. It represents original sources and modalities; data, observations and factual assertions; concepts and relationships; questions, alternatives, attempts and failures; interpretations, conclusions and decisions; provenance, contribution, time, epistemic state, policy, history and explicit gaps. It also represents how higher-level items derive from or relate to lower-level material. It is a representation of what was captured and permitted within scope, not the work's complete reality, a copy of a mind, or a guarantee that represented assertions are true.",
      "status": "proposed",
      "review_status": "needs-author-review",
      "origin": "system-proposal",
      "evidence_level": "logical-analysis",
      "audiences": [
        "audience:all",
