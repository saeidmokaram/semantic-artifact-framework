    {
      "@id": "claim:representation-technology-neutral",
      "@type": "Claim",
      "label": "The semantic approach must remain representation-technology neutral",
      "statement": "The proposed approach should define durable semantic obligations and exchange behaviour without requiring embeddings, natural-language prose, JSON, RDF, a graph database, a particular model, or any other current implementation technology. Implementations may combine or replace representations over time provided that they preserve the work's identity, meaning, provenance, relationships, history, epistemic status, source-derivative distinctions, governed omissions, and ability to migrate or exchange the knowledge.",
      "status": "working-thesis",
      "review_status": "author-reviewed",
      "origin": "human",
      "evidence_level": "direct-source",
      "audiences": [
        "audience:all",
        "audience:engineer",
        "audience:standards-author",
        "audience:archivist"
      ],
