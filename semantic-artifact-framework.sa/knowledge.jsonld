          "basis": "direct"
        }
      ],
      "tags": [
        "technology-neutral",
        "representation",
        "interoperability",
        "migration",
        "normative-semantics"
      ],
      "version": 1
    },
    {
      "@id": "concept:multimodal-source-record",
      "@type": "Concept",
      "label": "Multimodal source record",
      "statement": "An identified and governed source in any modality whose original form may carry recoverable meaning: structured data, natural language, code, image, diagram, sketch, audio, voice, music, video, spatial or sensor data, or an extensible future modality. The artifact may embed the content or reference an external object, but should preserve sufficient identity, integrity, provenance, access, rights, retention, timing, and format metadata to distinguish the source from later extractions or interpretations.",
      "status": "working-thesis",
      "review_status": "author-reviewed",
      "origin": "human",
      "evidence_level": "direct-source",
      "audiences": [
