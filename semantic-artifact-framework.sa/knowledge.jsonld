    {
      "@id": "decision:portable-five-file-bootstrap-package",
      "@type": "Decision",
      "label": "Provide the methodology as a portable five-file bootstrap package",
      "statement": "The current reusable bootstrap projection packages the minimum cross-platform method into README.md, INIT_PROMPT.md, METHODOLOGY.json, AGENT_POLICY.json and DATA_CONTRACT.json. It contains no default named authority or project subject matter: every new artifact must declare its own identity, contributors, governance, sources, rights and boundaries. The five-file layout is an experimental convenience for manual upload and handover, not a normative claim that all conforming implementations must use these filenames, JSON or a folder.",
      "status": "superseded",
      "review_status": "author-reviewed",
      "origin": "human",
