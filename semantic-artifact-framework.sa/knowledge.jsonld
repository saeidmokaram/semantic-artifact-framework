      "version": 1
    },
    {
      "@id": "claim:embeddings-as-derived-retrieval-aids",
      "@type": "Claim",
      "label": "Embeddings are optional derived retrieval aids, not a universal canonical form",
      "statement": "An embedding may improve retrieval or capture useful statistical structure, but it is model-, version-, parameter-, and context-dependent, may be lossy or difficult to inspect, and has no guaranteed universal representation shared by future systems. When used, it should be linked to its source and generation metadata and treated as a regenerable derivative or index rather than the only surviving canonical record of the knowledge.",
      "status": "working-thesis",
      "review_status": "author-reviewed",
      "origin": "human",
      "evidence_level": "direct-source",
