    {
      "@id": "contribution:revised-decision-jsonl-jsonld-canonical-jsonld-migration",
      "@type": "ContributionEvent",
      "target": "decision:jsonl-jsonld",
      "event_type": "revised",
      "actors": [
        {
          "contributor": "contributor:saeid-mokaram",
          "role": "approver"
        }
      ],
      "creation_method": "human",
      "occurred_at": "2026-08-14",
      "recorded_at": "2026-08-14",
      "attribution_confidence": "explicit",
      "basis": "direct-attribution",
      "related_event": "contribution:revised-decision-jsonl-jsonld-representation-neutrality",
      "change": {
        "fields": [
          "label",
          "statement",
          "status",
          "provenance",
          "relations",
          "tags",
          "version"
        ],
        "before": {
          "label": "JSON Lines and JSON-LD are current implementation choices",
          "statement": "The current repository representation stores one typed semantic object per JSON line for streaming and diffability, maps terms through a JSON-LD context, and generates a flattened JSON-LD publication graph. These formats demonstrate the idea but are not normative requirements of the proposed approach; another implementation may use different present or future technologies if it preserves the required semantics, identity, provenance, history, source-derivative distinctions, disclosure, and exchange behaviour.",
          "status": "proposed",
          "version": 3
        },
        "after": {
          "label": "JSON-LD graph exchange is the current repository implementation",
          "statement": "The repository now stores canonical semantic state and append-only contribution history as JSON-LD 1.1 graph documents using stable @id, @type and @graph constructs in a five-file exchange layout. This aligns the inspectable repository representation with the RDF data model and proposed SHACL constraints; the former JSON Lines canonical stores have been removed from the active repository. JSON-LD remains an implementation and exchange choice rather than a universal requirement: another implementation may use a different present or future technology if it preserves the required meaning, identity, provenance, relationships, history, policies, source-derivative distinctions, disclosure and exchange behaviour.",
          "status": "accepted",
          "version": 4
        },
        "rationale": "Implement the author's confirmed request to use the established JSON-LD/RDF-aligned graph form as the active repository representation, remove the former canonical JSON Lines stores, and retain technology neutrality as a framework principle."
      },
      "version": 1
    },
    {
